# Optional. Leave blank to use template-only planning and manual review.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=

# Optional web research and scene-based stock-footage discovery.
TAVILY_API_KEY=
PEXELS_API_KEY=

# Optional paid video/audio providers. Generation is an explicit user action.
RUNWAY_API_KEY=
RUNWAY_MODEL=seedance2_5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YouTube: use an OAuth 2.0 Desktop app client-secret JSON file.
YOUTUBE_CLIENT_SECRETS_FILE=

# Instagram publishing requires a professional account, an access token, and
# public object storage so Meta can fetch the rendered video.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_HOST=graph.instagram.com
INSTAGRAM_API_VERSION=v27.0

# Cloudflare R2 S3-compatible storage; set a public bucket/custom domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
